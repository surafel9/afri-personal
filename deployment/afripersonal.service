[Unit]
Description=AfriPersonal Telegram Job Matcher Service
After=network.target

[Service]
Type=simple
User=sinux
WorkingDirectory=/home/sinux/Projects/personal/afri-personal
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=10s
StateDirectory=afripersonal

# Environment & Secrets
EnvironmentFile=/home/sinux/Projects/personal/afri-personal/.env
Environment=NODE_ENV=production
Environment=DB_PATH=/var/lib/afripersonal/afripersonal.db

# Graceful termination
KillSignal=SIGTERM
TimeoutStopSec=30s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=afripersonal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/afripersonal

[Install]
WantedBy=multi-user.target
