# ── Required ────────────────────────────────────────────────────────────────
# Your Telegram bot token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Your personal Telegram chat ID (send /start to @userinfobot to find it)
OWNER_CHAT_ID=123456789

# ── Channel polling (automated ingestion) ────────────────────────────────────
# Public Telegram channel preview URL to poll for job posts.
# The format is: https://t.me/s/<channel_username>
# Leave this empty (or remove it) to run in manual-import-only mode.
TELEGRAM_CHANNEL_URL=https://t.me/s/freelance_ethio

# How often to poll the channel (in milliseconds).
# Default: 900000 = 15 minutes. Minimum: 60000 = 1 minute.
POLLING_INTERVAL_MS=900000

# ── Optional (defaults shown) ────────────────────────────────────────────────
# Minimum log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Path to the SQLite database file (relative to project root)
DB_PATH=data/afripersonal.db

# Minimum score (0–100) for a job to trigger a notification
NOTIFICATION_THRESHOLD=60

# Number of days to retain evaluated messages before cleanup
DATA_RETENTION_DAYS=90

